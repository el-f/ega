# Private key for the extension's stable `key` in manifest.config.ts.
# The PUBLIC half is committed in the manifest (safe — it's public). The
# PRIVATE PEM here is only needed to sign a packed .crx with the same
# identity; it's NOT required for unpacked dev loads (Chrome derives the
# extension ID from the public key alone). Keep it out of git as a
# courtesy / future-proofing for signed builds.
scripts/ega-extension-key.pem
scripts/*.pem
# LLM exploration agent — per-session transcripts + repros are large and
# machine-local. The session directory is the only on-disk side effect
# the agent produces outside its source files.
tests/explore/sessions/*
!tests/explore/sessions/.gitkeep
tests/explore/.profile/
# Editor and coding-agent local state.
.claude/
