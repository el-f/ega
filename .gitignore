node_modules/
.eslintcache
dist/
reports/
.turbo/
.vite/
.vite-cache/
coverage/
*.log
.env
.env.local
.env.*

# Visual audit artifacts — regenerated by `pnpm visual`. The report.json
# gates release locally; checked-in PNG baselines belong under
# tests/e2e/visual-regression.spec.ts-snapshots/ instead.
tests/screenshots/audit/report.json
tests/screenshots/audit/REPORT.md
tests/screenshots/audit/baseline/*.png
tests/screenshots/audit/proposals/
tests/screenshots/audit/current/
tests/screenshots/audit/meta/
tests/screenshots/audit/baseline-verdict.json
!tests/screenshots/audit/rubric/
!tests/screenshots/audit/rubric/*.md

# UX judge output: journey sidecars, captured frames and judge reports.
# Rubrics and the promoted baseline stay tracked.
tests/journeys/frames/
tests/journeys/report/
tests/journeys/runs/

store/*.zip
store/*.zip.sha256
store/*.map
.DS_Store
Thumbs.db
.worktrees/
.playwright-artifacts/
.playwright-mcp/
playwright-report/
test-results/
.stryker-tmp/
reports/mutation/
# Private keys never belong in git. The extension signing key defaults to
# ~/.ega (scripts/rotate-extension-key.ts); this catches a copy left in the tree.
*.pem
# LLM exploration agent — per-session transcripts + repros are large and
# machine-local. The session directory is the only on-disk side effect
# the agent produces outside its source files.
tests/explore/sessions/*
!tests/explore/sessions/.gitkeep
tests/explore/.profile/
# Editor and coding-agent local state.
.claude/
